{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novydres.local/schemas/PROVOCATION_LONGITUDINAL_SIDECAR_SCHEMA_V1.json",
  "title": "CHR001_LONGITUDINAL_PREPARATION_SIDECAR_V1",
  "description": "Supplemental metadata for FUTURE prepared provocations; original dossier schema V2 and already-published M2.04 are not rewritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "chronicle_id",
    "preparation_id",
    "source_checkpoint",
    "temporal_mode",
    "marco",
    "construction",
    "supernatural_monitor",
    "selection_method",
    "scene_relevance_rules",
    "agency_guards",
    "governance"
  ],
  "properties": {
    "schema_id": {
      "const": "CHR001_LONGITUDINAL_PREPARATION_SIDECAR_V1"
    },
    "chronicle_id": {
      "const": "CHR-001"
    },
    "preparation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_checkpoint": {
      "type": "object",
      "required": [
        "manifest_path",
        "live_path",
        "last_event_id"
      ],
      "properties": {
        "manifest_path": {
          "type": "string"
        },
        "live_path": {
          "type": "string"
        },
        "last_event_id": {
          "type": "string"
        },
        "head_commit": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "temporal_mode": {
      "type": "object",
      "required": [
        "starting_period",
        "proposed_scenic_scales",
        "diegetic_ellipsis_review"
      ],
      "properties": {
        "starting_period": {
          "type": "string"
        },
        "proposed_scenic_scales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SPOTLIGHT",
              "ABSTRACTION",
              "MONTAGE",
              "ELLIPSIS"
            ]
          }
        },
        "diegetic_ellipsis_review": {
          "type": "string"
        }
      }
    },
    "marco": {
      "type": "object",
      "required": [
        "id",
        "functional_target",
        "coverage_coherence_consequence_status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "functional_target": {
          "type": "string"
        },
        "coverage_coherence_consequence_status": {
          "type": "object",
          "required": [
            "coverage",
            "coherence",
            "consequence"
          ],
          "properties": {
            "coverage": {
              "type": "string"
            },
            "coherence": {
              "type": "string"
            },
            "consequence": {
              "type": "string"
            }
          }
        }
      }
    },
    "construction": {
      "type": "object",
      "required": [
        "longitudinal_relevance",
        "2010_feasibility_review",
        "experience_axes"
      ],
      "properties": {
        "longitudinal_relevance": {
          "type": "string",
          "minLength": 15
        },
        "2010_feasibility_review": {
          "type": "string"
        },
        "experience_axes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "IDENTITY",
              "MORALITY",
              "MECHANICAL",
              "RELATIONSHIP",
              "SOCIAL",
              "TERRITORIAL",
              "SUPERNATURAL",
              "CAINITE",
              "HISTORICAL"
            ]
          }
        }
      }
    },
    "supernatural_monitor": {
      "type": "object",
      "required": [
        "current_state",
        "trajectory_disposition",
        "justification"
      ],
      "properties": {
        "current_state": {
          "enum": [
            "UNKNOWN",
            "NO_EXPOSURE",
            "NPC_CLAIM",
            "ANOMALY",
            "VERIFIED_EVIDENCE",
            "CAINITE_INTERACTION",
            "PRE_EMBRACE",
            "EMBRACE",
            "NEW_VAMPIRE",
            "LONG_TERM_VAMPIRE",
            "CONVERGENCE_2010"
          ]
        },
        "trajectory_disposition": {
          "enum": [
            "CAUSAL_OPPORTUNITY",
            "DEBT_CARRIED",
            "BOUNDED_ABSENCE"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "selection_method": {
      "enum": [
        "D2_RNG_ELIGIBLE",
        "CHR001_CURATED_SESSION"
      ]
    },
    "selection_provenance": {
      "type": [
        "string",
        "null"
      ]
    },
    "scene_relevance_rules": {
      "type": "object",
      "required": [
        "why_now",
        "meaningful_choice",
        "potential_transformation",
        "anti_redundancy"
      ],
      "properties": {
        "why_now": {
          "type": "string"
        },
        "meaningful_choice": {
          "type": "string"
        },
        "potential_transformation": {
          "type": "string"
        },
        "anti_redundancy": {
          "type": "string"
        }
      }
    },
    "agency_guards": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "g28_scene_end_only",
        "no_new_story_events",
        "no_xp_or_fv_on_prep",
        "no_frozen_edits",
        "no_player_spoilers"
      ],
      "properties": {
        "g28_scene_end_only": {
          "const": true
        },
        "no_new_story_events": {
          "const": true
        },
        "no_xp_or_fv_on_prep": {
          "const": true
        },
        "no_frozen_edits": {
          "const": true
        },
        "no_player_spoilers": {
          "const": true
        }
      }
    },
    "secret_layer_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Never inline sensitive plot or NPC secrets into an ordinary player-facing file."
    }
  }
}
