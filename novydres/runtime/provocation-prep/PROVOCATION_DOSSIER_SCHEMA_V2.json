{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Niltond3/novydres-persistence-poc/blob/master/novydres/runtime/provocation-prep/PROVOCATION_DOSSIER_SCHEMA_V2.json",
  "title": "NOVYDRES Provocation dossier V2, conditional act credits",
  "description": "Complete conditional session module. Dossier preparation does not change LIVE, execute a scene, grant XP/FV or supersede G28.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "simulation_only",
    "chronicle_id",
    "episode_id",
    "preparation_id",
    "dossier_version",
    "status",
    "source_checkpoint",
    "sources",
    "dramatic_core",
    "established_facts",
    "prepared_truths",
    "npc_dossiers",
    "clues",
    "offscreen_clocks",
    "acts",
    "fallback_routes",
    "mechanical_preparation",
    "guards",
    "xp_credit_plan"
  ],
  "properties": {
    "schema_id": {
      "const": "NOVYDRES_PROVOCATION_DOSSIER_V2"
    },
    "simulation_only": {
      "type": "boolean"
    },
    "chronicle_id": {
      "const": "CHR-001"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "preparation_id": {
      "type": "string",
      "minLength": 1
    },
    "dossier_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "DRAFT_SYNTHETIC",
        "BLOCKED_CONFLICT",
        "PUBLISHED_NOT_STARTED",
        "RETIRED"
      ]
    },
    "source_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit_sha",
        "manifest_path",
        "live_path",
        "live_blob_sha",
        "history_index_path",
        "last_confirmed_event_id",
        "m203_status",
        "next_episode_status"
      ],
      "properties": {
        "base_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "live_path": {
          "type": "string",
          "minLength": 1
        },
        "live_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "history_index_path": {
          "type": "string",
          "minLength": 1
        },
        "last_confirmed_event_id": {
          "type": "string",
          "minLength": 1
        },
        "m203_status": {
          "const": "CLOSED"
        },
        "next_episode_status": {
          "const": "NOT_STARTED"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 3
    },
    "dramatic_core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "premise",
        "theme",
        "pressure",
        "open_questions",
        "agency_contract",
        "narrative_constraints"
      ],
      "properties": {
        "premise": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "pressure": {
          "type": "string",
          "minLength": 1
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "agency_contract": {
          "const": "PLAYER_CHOICES_NEVER_SCRIPTED"
        },
        "narrative_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "established_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/establishedFact"
      },
      "minItems": 0
    },
    "prepared_truths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preparedTruth"
      },
      "minItems": 0
    },
    "npc_dossiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/npc"
      },
      "minItems": 0
    },
    "clues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clue"
      },
      "minItems": 0
    },
    "offscreen_clocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clock"
      },
      "minItems": 0
    },
    "acts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/act"
      },
      "minItems": 1,
      "maxItems": 5
    },
    "fallback_routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fallback"
      },
      "minItems": 3,
      "allOf": [
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "REFUSAL"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "UNPLANNED_ACTION"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "FAILURE"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      ]
    },
    "mechanical_preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_ref",
        "take_half_ref",
        "narrator_gate_ref",
        "provisional_rules_ref",
        "only_proposed_tests",
        "rng_performed",
        "xp_fv_modified"
      ],
      "properties": {
        "engine_ref": {
          "type": "string",
          "minLength": 1
        },
        "take_half_ref": {
          "type": "string",
          "minLength": 1
        },
        "narrator_gate_ref": {
          "type": "string",
          "minLength": 1
        },
        "provisional_rules_ref": {
          "type": "string",
          "minLength": 1
        },
        "only_proposed_tests": {
          "const": true
        },
        "rng_performed": {
          "const": false
        },
        "xp_fv_modified": {
          "const": false
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "does_not_change_g28",
        "does_not_start_session",
        "does_not_advance_m204",
        "does_not_modify_history",
        "no_forced_pc_action",
        "player_handoff_contains_no_spoilers",
        "does_not_award_xp_on_preparation",
        "does_not_increase_budget_per_act"
      ],
      "properties": {
        "does_not_change_g28": {
          "const": true
        },
        "does_not_start_session": {
          "const": true
        },
        "does_not_advance_m204": {
          "const": true
        },
        "does_not_modify_history": {
          "const": true
        },
        "no_forced_pc_action": {
          "const": true
        },
        "player_handoff_contains_no_spoilers": {
          "const": true
        },
        "does_not_award_xp_on_preparation": {
          "const": true
        },
        "does_not_increase_budget_per_act": {
          "const": true
        }
      }
    },
    "xp_credit_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "cap_source",
        "cap_xp",
        "nominal_per_act",
        "planned_act_count",
        "planned_credit_potential",
        "grant_automatically_on_preparation",
        "reward_is_new_xp",
        "act_eligibility_event_required",
        "cap_is_absolute"
      ],
      "properties": {
        "policy_id": {
          "const": "DEC-CR-021"
        },
        "cap_source": {
          "const": "novydres/chronicles/CHR-001/character/TARGET_SHEET_V2_APPROVED.json"
        },
        "cap_xp": {
          "const": 675
        },
        "nominal_per_act": {
          "const": 10
        },
        "planned_act_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "planned_credit_potential": {
          "type": "integer",
          "minimum": 10,
          "maximum": 50,
          "multipleOf": 10
        },
        "grant_automatically_on_preparation": {
          "const": false
        },
        "reward_is_new_xp": {
          "const": false
        },
        "act_eligibility_event_required": {
          "const": true
        },
        "cap_is_absolute": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "role": {
          "type": "string",
          "enum": [
            "MANIFEST",
            "LIVE",
            "HISTORY_INDEX",
            "HISTORICAL_EVENT",
            "CANON",
            "DECISION",
            "KNOWLEDGE"
          ]
        }
      }
    },
    "establishedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "source_type",
        "source_path",
        "source_event_id",
        "visibility"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": [
            "CONFIRMED_EVENT",
            "CANON_SOURCE"
          ]
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "type": "string",
          "enum": [
            "GM_HIDDEN",
            "PLAYER_KNOWN",
            "SYSTEM_AUDIT"
          ]
        }
      }
    },
    "preparedTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prep_id",
        "text",
        "epistemic_status",
        "visibility",
        "preconditions"
      ],
      "properties": {
        "prep_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "epistemic_status": {
          "const": "PREPARED"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "GM_HIDDEN",
            "PLAYER_SAFE"
          ]
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "act_id",
        "dramatic_function",
        "entry_options",
        "frames",
        "possible_exit_conditions",
        "nonlinear",
        "xp_credit_nominal",
        "xp_credit_status",
        "act_is_substantive"
      ],
      "properties": {
        "act_id": {
          "type": "string",
          "minLength": 1
        },
        "dramatic_function": {
          "type": "string",
          "minLength": 1
        },
        "entry_options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          },
          "minItems": 1
        },
        "possible_exit_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "nonlinear": {
          "const": true
        },
        "xp_credit_nominal": {
          "const": 10
        },
        "xp_credit_status": {
          "const": "PLANNED_NOT_GRANTED"
        },
        "act_is_substantive": {
          "const": true
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "purpose",
        "location_options",
        "possible_entry_conditions",
        "scenes",
        "possible_exit_conditions",
        "is_mandatory"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "location_options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "possible_entry_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          },
          "minItems": 1
        },
        "possible_exit_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "is_mandatory": {
          "const": false
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "possible_entry",
        "conflict",
        "stakes",
        "npc_active_goals",
        "optional_beats",
        "conditional_outcomes",
        "possible_exit_conditions",
        "clue_ids",
        "test_preflight_refs",
        "pc_decisions_unwritten"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "possible_entry": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "conflict": {
          "type": "string",
          "minLength": 1
        },
        "stakes": {
          "type": "string",
          "minLength": 1
        },
        "npc_active_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "optional_beats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/beat"
          },
          "minItems": 0
        },
        "conditional_outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome"
          },
          "minItems": 2,
          "contains": {
            "type": "object",
            "required": [
              "supports_refusal_or_diversion"
            ],
            "properties": {
              "supports_refusal_or_diversion": {
                "const": true
              }
            }
          },
          "minContains": 1
        },
        "possible_exit_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "clue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "test_preflight_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "pc_decisions_unwritten": {
          "const": true
        }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beat_id",
        "prompt_or_npc_action",
        "optional",
        "epistemic_status"
      ],
      "properties": {
        "beat_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_or_npc_action": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "const": true
        },
        "epistemic_status": {
          "const": "PREPARED"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "trigger",
        "possible_consequence",
        "status",
        "supports_refusal_or_diversion"
      ],
      "properties": {
        "outcome_id": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "possible_consequence": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "CONDITIONAL"
        },
        "supports_refusal_or_diversion": {
          "type": "boolean"
        }
      }
    },
    "npc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_origin",
        "source_path",
        "personal_goal",
        "resources",
        "knowledge",
        "when_pc_absent",
        "conditional_responses",
        "secrets_visibility"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_origin": {
          "type": "string",
          "enum": [
            "ESTABLISHED_ENTITY",
            "PREPARED_ENTITY"
          ]
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "personal_goal": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "knowledge": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "status",
              "event_id"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "KNOWN",
                  "CLAIMED",
                  "SUSPECTED",
                  "UNKNOWN"
                ]
              },
              "event_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "minItems": 0
        },
        "when_pc_absent": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "conditional_responses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trigger",
              "possible_response",
              "status"
            ],
            "properties": {
              "trigger": {
                "type": "string",
                "minLength": 1
              },
              "possible_response": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "CONDITIONAL"
              }
            }
          },
          "minItems": 0
        },
        "secrets_visibility": {
          "const": "GM_HIDDEN"
        }
      }
    },
    "clue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clue_id",
        "meaning_if_discovered",
        "critical",
        "revelation_status",
        "discovery_routes"
      ],
      "properties": {
        "clue_id": {
          "type": "string",
          "minLength": 1
        },
        "meaning_if_discovered": {
          "type": "string",
          "minLength": 1
        },
        "critical": {
          "type": "boolean"
        },
        "revelation_status": {
          "const": "PREPARED"
        },
        "discovery_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "route_id",
              "conditions",
              "holder_or_location"
            ],
            "properties": {
              "route_id": {
                "type": "string",
                "minLength": 1
              },
              "conditions": {
                "type": "string",
                "minLength": 1
              },
              "holder_or_location": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 2
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_id",
        "trigger",
        "possible_consequence",
        "status",
        "runs_on_turn_count"
      ],
      "properties": {
        "clock_id": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "possible_consequence": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "CONDITIONAL"
        },
        "runs_on_turn_count": {
          "const": false
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "npc_reaction_basis",
        "possible_routes",
        "pc_forced"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "REFUSAL",
            "UNPLANNED_ACTION",
            "FAILURE",
            "DEPARTURE",
            "DELAY"
          ]
        },
        "npc_reaction_basis": {
          "type": "string",
          "minLength": 1
        },
        "possible_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "pc_forced": {
          "const": false
        }
      }
    }
  }
}
