{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Niltond3/novydres-persistence-poc/blob/master/novydres/runtime/provocation-prep/PROVOCATION_LONGITUDINAL_SIDECAR_SCHEMA_V5.json",
  "title": "CHR001 longitudinal handoff sidecar V4 successor V5",
  "description": "PLAYER_SAFE longitudinal status with explicit quiet-wait, admissible-cause, and alternate-closure choices; no time, cause, actor, or stakes are created. The V8 runtime validator pins source_checkpoint to the immediately preceding operational cycle and that cycle’s manifest. This schema requires explicit pins for all six current operational source classes (LIVE, history, episode, character state, NPC knowledge, and open threads); runtime validation matches each path/blob to the predecessor cycle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "chronicle_id",
    "preparation_id",
    "status",
    "source_checkpoint",
    "source_refs",
    "scene_ready",
    "SCENE_READY",
    "NARRATOR_PERMISSION",
    "provocation_status",
    "temporal_mode",
    "marco",
    "construction",
    "supernatural_monitor",
    "selection_method",
    "selection_provenance",
    "handoff",
    "professional_code_guard",
    "closure_routing",
    "agency_guards",
    "governance",
    "story_preparation_ready",
    "predecessor_ref"
  ],
  "properties": {
    "schema_id": {
      "const": "NOVYDRES_PROVOCATION_LONGITUDINAL_SIDECAR_V5"
    },
    "chronicle_id": {
      "const": "CHR-001"
    },
    "preparation_id": {
      "type": "string",
      "pattern": "^CHR001-PREP-M301-[0-9]{8}-V[0-9]+$"
    },
    "status": {
      "const": "HANDOFF_PENDING_PLAYER_DECISION"
    },
    "source_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit_sha",
        "cycle_path",
        "cycle_blob_sha",
        "manifest_path",
        "manifest_blob_sha",
        "live_path",
        "live_blob_sha",
        "history_index_path",
        "history_index_blob_sha",
        "episode_path",
        "episode_blob_sha",
        "last_event_id",
        "last_closed_scene",
        "provocation_status",
        "next_scene",
        "next_scene_status",
        "protagonist_mortal",
        "embrace_occurred",
        "dossier_path",
        "dossier_blob_sha",
        "knowledge_path",
        "knowledge_blob_sha",
        "open_threads_path",
        "open_threads_blob_sha"
      ],
      "properties": {
        "base_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "cycle_path": {
          "type": "string",
          "pattern": "^novydres/chronicles/CHR-001/orchestration/CYCLE_V[0-9]{4}\\.json$"
        },
        "cycle_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifest_path": {
          "type": "string",
          "pattern": "^novydres/MANIFEST_V[0-9]+\\.json$"
        },
        "manifest_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "live_path": {
          "type": "string",
          "minLength": 1
        },
        "live_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "history_index_path": {
          "type": "string",
          "minLength": 1
        },
        "history_index_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "episode_path": {
          "type": "string",
          "minLength": 1
        },
        "episode_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "last_event_id": {
          "type": "string",
          "minLength": 1
        },
        "last_closed_scene": {
          "const": "C05"
        },
        "provocation_status": {
          "const": "OPEN"
        },
        "next_scene": {
          "const": "C06"
        },
        "next_scene_status": {
          "const": "NOT_STARTED"
        },
        "protagonist_mortal": {
          "const": true
        },
        "embrace_occurred": {
          "const": false
        },
        "dossier_path": {
          "type": "string",
          "minLength": 1
        },
        "dossier_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "knowledge_path": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "open_threads_path": {
          "type": "string",
          "minLength": 1
        },
        "open_threads_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "blob_sha",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scene_ready": {
      "const": false
    },
    "SCENE_READY": {
      "const": false
    },
    "NARRATOR_PERMISSION": {
      "const": false
    },
    "provocation_status": {
      "const": "OPEN"
    },
    "temporal_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starting_period",
        "proposed_scenic_scales",
        "diegetic_ellipsis_review"
      ],
      "properties": {
        "starting_period": {
          "type": "string",
          "minLength": 1
        },
        "proposed_scenic_scales": {
          "const": []
        },
        "diegetic_ellipsis_review": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "marco": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "functional_target",
        "coverage_coherence_consequence_status"
      ],
      "properties": {
        "id": {
          "const": "M3"
        },
        "functional_target": {
          "type": "string",
          "minLength": 1
        },
        "coverage_coherence_consequence_status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage",
            "coherence",
            "consequence"
          ],
          "properties": {
            "coverage": {
              "type": "string",
              "minLength": 1
            },
            "coherence": {
              "type": "string",
              "minLength": 1
            },
            "consequence": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longitudinal_relevance",
        "2010_feasibility_review",
        "experience_axes"
      ],
      "properties": {
        "longitudinal_relevance": {
          "type": "string",
          "minLength": 15
        },
        "2010_feasibility_review": {
          "type": "string",
          "minLength": 1
        },
        "experience_axes": {
          "const": []
        }
      }
    },
    "supernatural_monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_state",
        "trajectory_disposition",
        "justification"
      ],
      "properties": {
        "current_state": {
          "enum": [
            "UNKNOWN",
            "NO_EXPOSURE",
            "NPC_CLAIM",
            "ANOMALY",
            "VERIFIED_EVIDENCE",
            "CAINITE_INTERACTION",
            "PRE_EMBRACE",
            "EMBRACE",
            "NEW_VAMPIRE",
            "LONG_TERM_VAMPIRE",
            "CONVERGENCE_2010"
          ]
        },
        "trajectory_disposition": {
          "const": "BOUNDED_ABSENCE"
        },
        "justification": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "selection_method": {
      "const": "NONE_HANDOFF_ONLY"
    },
    "selection_provenance": {
      "type": "string",
      "minLength": 1
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "diegetic_why_now",
        "cause",
        "actors",
        "entry_condition",
        "stakes",
        "prepared_scenes",
        "acts",
        "player_decision_pending",
        "npc_knowledge_delta",
        "knowledge_boundary",
        "next_decision"
      ],
      "properties": {
        "status": {
          "const": "HANDOFF_PENDING_PLAYER_DECISION"
        },
        "diegetic_why_now": {
          "const": null
        },
        "cause": {
          "const": null
        },
        "actors": {
          "const": []
        },
        "entry_condition": {
          "const": null
        },
        "stakes": {
          "const": null
        },
        "prepared_scenes": {
          "const": []
        },
        "acts": {
          "const": []
        },
        "player_decision_pending": {
          "const": true
        },
        "npc_knowledge_delta": {
          "const": []
        },
        "knowledge_boundary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cause_status",
            "default_if_no_action",
            "decision_recorded",
            "choices"
          ],
          "properties": {
            "cause_status": {
              "const": "NO_C06_CAUSE_ADMITTED_OR_AVAILABLE"
            },
            "default_if_no_action": {
              "const": "KEEP_OPEN_QUIET"
            },
            "decision_recorded": {
              "const": false
            },
            "choices": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "choice_id",
                      "availability",
                      "effect"
                    ],
                    "properties": {
                      "choice_id": {
                        "const": "KEEP_OPEN_QUIET"
                      },
                      "availability": {
                        "const": "AVAILABLE_NOW"
                      },
                      "effect": {
                        "type": "string",
                        "minLength": 20
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "choice_id",
                      "availability",
                      "effect"
                    ],
                    "properties": {
                      "choice_id": {
                        "const": "CONTINUE_AFTER_ADMISSION"
                      },
                      "availability": {
                        "const": "UNAVAILABLE_UNTIL_CAUSE_ADMITTED_AND_AVAILABLE"
                      },
                      "effect": {
                        "type": "string",
                        "minLength": 20
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "choice_id",
                      "availability",
                      "effect"
                    ],
                    "properties": {
                      "choice_id": {
                        "const": "REQUEST_ALTERNATE_CLOSURE"
                      },
                      "availability": {
                        "const": "AVAILABLE_ON_EXPLICIT_PLAYER_REQUEST"
                      },
                      "effect": {
                        "type": "string",
                        "minLength": 20
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "professional_code_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_event_id",
        "source_path",
        "source_blob_sha",
        "rule",
        "no_change_from_c05_banter",
        "no_service_or_fee_inferred"
      ],
      "properties": {
        "source_event_id": {
          "const": "CHR001-M301-C03-19-20261107-001"
        },
        "source_path": {
          "const": "novydres/chronicles/CHR-001/episodes/M3.01_v003.source.txt"
        },
        "source_blob_sha": {
          "const": "6df92713ce5d161b078c3bf93e4cf16a0d7b6769"
        },
        "rule": {
          "type": "string",
          "minLength": 20
        },
        "no_change_from_c05_banter": {
          "const": true
        },
        "no_service_or_fee_inferred": {
          "const": true
        }
      }
    },
    "closure_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation",
        "effect",
        "player_decision_required",
        "provocation_closed",
        "event_created"
      ],
      "properties": {
        "recommendation": {
          "const": "PROVOCATION_CLOSURE_PENDING"
        },
        "effect": {
          "const": "ROUTING_ONLY"
        },
        "player_decision_required": {
          "const": true
        },
        "provocation_closed": {
          "const": false
        },
        "event_created": {
          "const": false
        }
      }
    },
    "agency_guards": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_story_event_created",
        "no_time_advanced",
        "no_xp_or_fv_on_prep",
        "no_npc_knowledge_delta",
        "no_player_spoilers"
      ],
      "properties": {
        "no_story_event_created": {
          "const": true
        },
        "no_time_advanced": {
          "const": true
        },
        "no_xp_or_fv_on_prep": {
          "const": true
        },
        "no_npc_knowledge_delta": {
          "const": true
        },
        "no_player_spoilers": {
          "const": true
        }
      }
    },
    "story_preparation_ready": {
      "const": false
    },
    "predecessor_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blob_sha"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^novydres/chronicles/CHR-001/preparations/M3\\.01_DOSSIER_V[0-9]+\\.json$"
        },
        "blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
