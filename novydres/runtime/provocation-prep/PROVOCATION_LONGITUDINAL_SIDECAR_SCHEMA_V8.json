{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novydres.local/CHR-001/SIDECAR_SCHEMA_V8",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "chronicle_id",
    "episode_id",
    "preparation_id",
    "classification",
    "status",
    "dossier_ref",
    "source_checkpoint",
    "authority_refs",
    "selection_method",
    "marco",
    "horizon_2010",
    "supernatural_monitor",
    "temporal_policy",
    "scene_queue",
    "choices_and_outcomes",
    "causal_relays",
    "protected_state",
    "operational_gates",
    "no_narration",
    "no_new_event",
    "causal_entry",
    "predecessor_ref"
  ],
  "properties": {
    "schema_id": {
      "const": "NOVYDRES_PROVOCATION_LONGITUDINAL_SIDECAR_V8"
    },
    "chronicle_id": {
      "const": "CHR-001"
    },
    "episode_id": {
      "const": "M3.02"
    },
    "preparation_id": {
      "type": "string",
      "pattern": "^CHR001-PREP-M302-[0-9]{8}-V[0-9]+$"
    },
    "classification": {
      "const": "GM_HIDDEN"
    },
    "status": {
      "const": "PROSPECTIVE_SPOTLIGHT_FRAME_NARRATOR_GRANT_CANDIDATE"
    },
    "dossier_ref": {
      "$ref": "#/$defs/blobRef"
    },
    "source_checkpoint": {
      "type": "object",
      "required": [
        "cycle",
        "manifest",
        "last_event_id",
        "state_refs"
      ],
      "properties": {
        "cycle": {
          "$ref": "#/$defs/blobRef"
        },
        "manifest": {
          "$ref": "#/$defs/blobRef"
        },
        "last_event_id": {
          "const": "CHR001-M301-C05-22-20261109-001"
        },
        "state_refs": {
          "$ref": "#/$defs/stateRefs"
        }
      }
    },
    "authority_refs": {
      "type": "object",
      "required": [
        "admission",
        "bible",
        "truth",
        "preparation",
        "progression"
      ]
    },
    "selection_method": {
      "const": "CHR001_CURATED_SESSION"
    },
    "marco": {
      "type": "object",
      "required": [
        "id",
        "function",
        "coverage",
        "coherence",
        "consequence"
      ],
      "properties": {
        "id": {
          "const": "M3"
        }
      }
    },
    "horizon_2010": {
      "type": "string",
      "minLength": 1
    },
    "supernatural_monitor": {
      "type": "object",
      "required": [
        "present",
        "planned",
        "current_condition",
        "continuity"
      ]
    },
    "temporal_policy": {
      "type": "object",
      "required": [
        "confirmed_year",
        "exact_date",
        "current_elapsed_time",
        "starts_in_car"
      ],
      "properties": {
        "confirmed_year": {
          "const": 1970
        },
        "exact_date": {
          "const": "UNKNOWN"
        },
        "current_elapsed_time": {
          "const": "NONE_FROM_C05_22"
        },
        "starts_in_car": {
          "const": true
        }
      }
    },
    "scene_queue": {
      "type": "object",
      "required": [
        "first",
        "status",
        "entry_realized",
        "scene_ready",
        "narrator_permission"
      ],
      "properties": {
        "first": {
          "const": "M3.02.C01"
        },
        "status": {
          "const": "NOT_STARTED"
        },
        "entry_realized": {
          "const": false
        },
        "scene_ready": {
          "const": true
        },
        "narrator_permission": {
          "const": true
        }
      }
    },
    "choices_and_outcomes": {
      "type": "array",
      "minItems": 1
    },
    "causal_relays": {
      "type": "array",
      "minItems": 1
    },
    "protected_state": {
      "type": "object",
      "required": [
        "six_refs",
        "xp_unchanged",
        "wp_unchanged",
        "npc_knowledge_unchanged",
        "threads_unchanged"
      ],
      "properties": {
        "six_refs": {
          "$ref": "#/$defs/stateRefs"
        },
        "xp_unchanged": {
          "const": true
        },
        "wp_unchanged": {
          "const": true
        },
        "npc_knowledge_unchanged": {
          "const": true
        },
        "threads_unchanged": {
          "const": true
        }
      }
    },
    "operational_gates": {
      "type": "object",
      "required": [
        "admin_eligible",
        "admin_validated",
        "story_preparation_ready",
        "mechanical_scene_ready",
        "scene_ready",
        "narrator_permission"
      ],
      "properties": {
        "admin_eligible": {
          "const": true
        },
        "admin_validated": {
          "const": true
        },
        "story_preparation_ready": {
          "const": true
        },
        "mechanical_scene_ready": {
          "const": true
        },
        "scene_ready": {
          "const": true
        },
        "narrator_permission": {
          "const": true
        }
      }
    },
    "no_narration": {
      "const": true
    },
    "no_new_event": {
      "const": true
    },
    "causal_entry": {
      "type": "object",
      "required": [
        "prepared_world_cause",
        "elapsed_time_recorded",
        "scene_started",
        "player_must_move_from_car",
        "player_must_return_to_workshop",
        "player_must_unload",
        "player_must_accept_invitation",
        "routine_ellipsis_allowed",
        "independent_npc_agency",
        "event_realized",
        "prior_intention_requirement"
      ],
      "properties": {
        "prepared_world_cause": {
          "const": true
        },
        "elapsed_time_recorded": {
          "const": false
        },
        "scene_started": {
          "const": false
        },
        "player_must_move_from_car": {
          "const": false
        },
        "player_must_return_to_workshop": {
          "const": false
        },
        "player_must_unload": {
          "const": false
        },
        "player_must_accept_invitation": {
          "const": false
        },
        "routine_ellipsis_allowed": {
          "const": true
        },
        "independent_npc_agency": {
          "const": true
        },
        "event_realized": {
          "const": false
        },
        "prior_intention_requirement": {
          "type": "string",
          "minLength": 15
        }
      }
    },
    "predecessor_ref": {
      "$ref": "#/$defs/blobRef"
    }
  },
  "$defs": {
    "blobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blob_sha"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "stateRefs": {
      "type": "object",
      "required": [
        "live",
        "history_index",
        "episode",
        "character",
        "knowledge",
        "threads"
      ],
      "properties": {
        "live": {
          "$ref": "#/$defs/blobRef"
        },
        "history_index": {
          "$ref": "#/$defs/blobRef"
        },
        "episode": {
          "$ref": "#/$defs/blobRef"
        },
        "character": {
          "$ref": "#/$defs/blobRef"
        },
        "knowledge": {
          "$ref": "#/$defs/blobRef"
        },
        "threads": {
          "$ref": "#/$defs/blobRef"
        }
      }
    }
  },
  "title": "CHR001 M3.02 significant scene frame sidecar V8"
}
