{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Niltond3/novydres-persistence-poc/blob/master/novydres/runtime/narrative-architecture/ATLAS_SNAPSHOT_SCHEMA_V1.json",
  "title": "NOVYDRES CHR-001 Narrative Atlas Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "chronicle_id",
    "version",
    "status",
    "baseline",
    "sources",
    "entities",
    "edges",
    "event_cards",
    "story_arcs",
    "scenario_seeds",
    "coverage"
  ],
  "properties": {
    "schema_id": {
      "const": "CHR001_NARRATIVE_ATLAS_SNAPSHOT_V1"
    },
    "chronicle_id": {
      "const": "CHR-001"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "PARTIAL",
        "AUDITED_COMPLETE",
        "BLOCKED_CONFLICT"
      ]
    },
    "baseline": {
      "type": "object",
      "required": [
        "head_sha",
        "cycle_path",
        "live_path",
        "last_event_id"
      ],
      "properties": {
        "head_sha": {
          "type": "string"
        },
        "cycle_path": {
          "type": "string"
        },
        "live_path": {
          "type": "string"
        },
        "last_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "diegetic_time": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "event_cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "story_arcs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/arc"
      }
    },
    "scenario_seeds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/seed"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "path",
        "blob_sha",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "blob_sha": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "ORIGINAL_PLAYED",
            "LEGACY_ARCHIVE",
            "SEARCH_INDEX_STALE",
            "GM_PREPARATION",
            "CURRENT_OPERATIONAL",
            "AUTHORIAL_DECISION",
            "CANON",
            "DERIVED"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "source_path",
        "source_blob_sha",
        "source_type"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_blob_sha": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "CONFIRMED_EVENT",
            "PLAYER_DECLARATION",
            "NPC_CLAIM",
            "NARRATOR_ADJUDICATION",
            "CANON_SOURCE",
            "GM_PREPARED",
            "EDITORIAL_RECONSTRUCTION",
            "UNKNOWN"
          ]
        },
        "event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "location_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "enum": [
            "PLAYER_SAFE",
            "CHARACTER_KNOWN",
            "NPC_SPECIFIC",
            "GM_HIDDEN",
            "UNKNOWN"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "event_id"
          ]
        },
        {
          "required": [
            "anchor"
          ]
        }
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "label",
        "kind",
        "contact_class",
        "identity_status",
        "aliases",
        "states",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "PC",
            "NPC",
            "ORGANIZATION",
            "GROUP"
          ]
        },
        "contact_class": {
          "enum": [
            "DIRECT_SCENE",
            "MEDIATED_INTERACTION",
            "MATERIAL_IMPACT",
            "MENTION_ONLY",
            "NPC_ONLY",
            "UNKNOWN"
          ]
        },
        "identity_status": {
          "enum": [
            "IDENTIFIED",
            "ANONYMOUS_INDIVIDUATED",
            "ALIAS_UNRESOLVED",
            "UNKNOWN"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "suspected_same_as": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": [
        "as_of_event_id",
        "vital_status",
        "position",
        "objectives",
        "constraints",
        "knowledge",
        "affiliations",
        "evidence"
      ],
      "properties": {
        "as_of_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "vital_status": {
          "enum": [
            "ALIVE_CONFIRMED",
            "DEAD_CONFIRMED",
            "UNCONFIRMED",
            "UNKNOWN"
          ]
        },
        "position": {
          "type": [
            "string",
            "null"
          ]
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knowledge": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affiliations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mood_h": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -5,
          "maximum": 5
        },
        "relationship_b": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -5,
          "maximum": 5
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "epistemic_status",
        "relationship_b",
        "as_of_event_id",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "FAMILY",
            "FRIENDSHIP",
            "RIVALRY",
            "AUTHORITY",
            "EMPLOYMENT",
            "DEBT",
            "FEAR",
            "RESPECT",
            "TRUST",
            "DEPENDENCY",
            "SECRET",
            "COERCION",
            "AGREEMENT",
            "AFFILIATION",
            "INFORMATION",
            "OTHER"
          ]
        },
        "epistemic_status": {
          "enum": [
            "CONFIRMED",
            "ONE_SIDED_PERCEPTION",
            "NPC_CLAIM",
            "SUSPECTED",
            "PREPARED_ONLY",
            "UNKNOWN"
          ]
        },
        "relationship_b": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -5,
          "maximum": 5
        },
        "as_of_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "scene",
        "status",
        "diegetic_time",
        "actors",
        "arc_ids",
        "change",
        "origin_type",
        "authorship",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "scene": {
          "type": "string"
        },
        "status": {
          "enum": [
            "PLAYED",
            "PREPARATION_ONLY",
            "HISTORICAL_SOURCE_UNVERIFIED"
          ]
        },
        "diegetic_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "arc_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "change": {
          "type": "string"
        },
        "origin_type": {
          "enum": [
            "CONFIRMED_EVENT",
            "PLAYER_DECLARATION",
            "NPC_CLAIM",
            "NARRATOR_ADJUDICATION",
            "CANON_SOURCE",
            "GM_PREPARED",
            "EDITORIAL_RECONSTRUCTION",
            "UNKNOWN"
          ]
        },
        "authorship": {
          "enum": [
            "PLAYER",
            "NARRATOR",
            "DRAMATURGO",
            "SHARED_EMERGENT",
            "AUTHOR_UNKNOWN"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "additionalProperties": false
    },
    "arc": {
      "type": "object",
      "required": [
        "id",
        "title",
        "story_status",
        "causal_premise",
        "agents",
        "opposing_forces",
        "timeline_event_ids",
        "independent_initiatives",
        "unresolved_questions",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "story_status": {
          "enum": [
            "LATENT",
            "ACTIVE",
            "ESCALATING",
            "SUSPENDED",
            "RESOLVED",
            "ABANDONED",
            "UNKNOWN",
            "PREPARATION_ONLY"
          ]
        },
        "causal_premise": {
          "type": "string"
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "opposing_forces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeline_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "independent_initiatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preparation_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "visibility": {
          "enum": [
            "PLAYER_SAFE",
            "GM_HIDDEN",
            "UNKNOWN"
          ]
        }
      },
      "additionalProperties": false
    },
    "seed": {
      "type": "object",
      "required": [
        "id",
        "as_of_event_id",
        "alternate_viewpoint",
        "allowed_fact_ids",
        "unknowns",
        "branch_required",
        "visibility"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "as_of_event_id": {
          "type": "string"
        },
        "alternate_viewpoint": {
          "type": "string"
        },
        "allowed_fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "branch_required": {
          "type": "boolean"
        },
        "visibility": {
          "enum": [
            "PLAYER_SAFE",
            "GM_HIDDEN",
            "UNKNOWN"
          ]
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "periods",
        "reviewed_source_paths",
        "unreviewed_source_paths",
        "gaps",
        "conflicts",
        "validation_status"
      ],
      "properties": {
        "periods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewed_source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unreviewed_source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_status": {
          "enum": [
            "NOT_RUN",
            "STRUCTURAL_ONLY",
            "SEMANTIC_PARTIAL",
            "AUDITED"
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    }
  }
}
