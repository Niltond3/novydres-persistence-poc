  "limits": [
    "This registry copies the frozen D01 proposal for validation only.",
    "It does not activate, amend, supersede or promote D01 contracts.",
    "Operational authorization, scene readiness and narrator permission remain separate gates.",
    "D10 rejects GM_HIDDEN payloads outright because it does not implement an independently verifiable segregation attestation mechanism."
  ],
  "compatibility_notes": [
    {
      "constraint": "D01 phase_handoff.status only permits PASS, FAIL, PENDING_PLAYER_APPROVAL and STOP_CONFLICT.",
      "handling": "Keep D01 byte-for-byte unchanged; use D10_PHASE_ENVELOPE_SCHEMA_V001.json for program execution states, including PASS_WITH_UNKNOWN.",
      "authority": "ADDITIVE_DOCUMENTARY_ADAPTER_ONLY"
    }
  ],
  "validator_enforced_bundle_records": {
    "source_checkpoint": {
      "required": "source_head and an independently supplied expected source HEAD",
      "checks": [
        "repository HEAD equals expected HEAD",
        "source path remains beneath repository root",
        "source path is tracked at expected HEAD",
        "working bytes and expected Git tree blob match pinned blob SHA"
      ]
    },
    "npc_knowledge_acquisition": {
      "required": [
        "acquisition_id",
        "knower_id",
        "event_id",
        "method",
        "evidence_id",
        "source"
      ],
      "methods": [
        "OBSERVED",
        "HEARD",
        "READ",
        "TOLD",
        "INFERRED",
        "SHARED",
        "OTHER"
      ],
      "checks": [
        "actor match",
        "known checkpoint event",
        "verified evidence record",
        "acquisition does not postdate knowledge",
        "source file is tracked at the expected Git HEAD and blob SHA matches"
      ]
    },
    "player_decision": {
      "required": [
        "decision_id",
        "decision_maker",
        "decision_kind",
        "scope",
        "affected_refs",
        "event_id",
        "evidence_id",
        "source"
      ],
      "retcon_approval_checks": [
        "decision_maker PLAYER",
        "RETCON_APPROVAL",
        "EXACT_RETCON",
        "exact affected_refs",
        "verified source and evidence"
      ]
    },
    "gm_hidden": "All GM_HIDDEN payloads are rejected while this proposal lacks an independently verified segregation attestation mechanism.",
    "phase_success": "PASS/PASS_WITH_UNKNOWN and D12 final release require all catalogued validation checks to pass, complete technical/literary reviews and valid publication/readback."
  }
