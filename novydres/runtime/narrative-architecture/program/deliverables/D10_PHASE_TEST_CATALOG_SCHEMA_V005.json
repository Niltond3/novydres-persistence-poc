{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novydres.invalid/chr-001/d10/phase-test-catalog/v005",
  "title": "NOVYDRES CHR-001 phase test catalog V005",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "version",
    "phase",
    "test_runner",
    "test_cases"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "V005"
    },
    "phase": {
      "enum": [
        "D05",
        "D06",
        "D07",
        "D08",
        "D09",
        "D10",
        "D11",
        "D12"
      ]
    },
    "test_runner": {
      "type": "string",
      "pattern": "^novydres/runtime/narrative-architecture/program/deliverables/[A-Za-z0-9._-]+\\.py$"
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "description",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "const": "PASS"
          }
        }
      }
    }
  }
}
