{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Niltond3/novydres-persistence-poc/blob/master/novydres/runtime/scene-execution/SCENE_PACKET_SCHEMA_V1.json",
  "title": "NOVYDRES scene execution ephemeral packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "chronicle_id",
    "source_checkpoint",
    "status",
    "scene",
    "resources",
    "participants",
    "facts",
    "threads",
    "mechanics",
    "player_agency",
    "event_buffer"
  ],
  "properties": {
    "protocol_version": {
      "const": "NOVYDRES_SCENE_EXECUTION_V1"
    },
    "chronicle_id": {
      "const": "CHR-001"
    },
    "source_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "manifest_path",
        "live_path",
        "event_id"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "live_path": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "PRE_SESSION_LOCKED",
        "PREPARED_NOT_STARTED",
        "OPEN",
        "CLOSED_PENDING_COMMIT",
        "CLOSED_COMMITTED",
        "PENDING_PERSISTENCE",
        "CONFLICT"
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "episode_id",
        "diegetic_period",
        "location",
        "scene_started"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "diegetic_period": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "scene_started": {
          "type": "boolean"
        },
        "last_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_condition": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xp_total",
        "xp_spent",
        "xp_remaining",
        "xp_credit_available",
        "fv_max_provisional",
        "fv_superficial",
        "fv_aggravated",
        "fv_available",
        "source_ref"
      ],
      "properties": {
        "xp_total": {
          "type": "integer",
          "minimum": 0
        },
        "xp_spent": {
          "type": "integer",
          "minimum": 0
        },
        "xp_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "xp_credit_available": {
          "type": "integer",
          "minimum": 0
        },
        "fv_max_provisional": {
          "type": "integer",
          "minimum": 0
        },
        "fv_superficial": {
          "type": "integer",
          "minimum": 0
        },
        "fv_aggravated": {
          "type": "integer",
          "minimum": 0
        },
        "fv_available": {
          "type": "integer",
          "minimum": 0
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "role",
          "knowledge_ref"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "PC",
              "NPC",
              "GROUP"
            ]
          },
          "knowledge_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposition_id",
          "text",
          "epistemic_status",
          "source_event_id",
          "visibility"
        ],
        "properties": {
          "proposition_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "epistemic_status": {
            "enum": [
              "CONFIRMED",
              "NPC_CLAIM",
              "SUSPECTED",
              "UNKNOWN",
              "PLAYER_INTENT",
              "NARRATOR_HYPOTHESIS"
            ]
          },
          "source_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "visibility": {
            "enum": [
              "PLAYER_PUBLIC",
              "PC_KNOWN",
              "NPC_BELIEF",
              "GM_HIDDEN",
              "SYSTEM_AUDIT"
            ]
          }
        }
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thread_id",
          "status",
          "source_ref"
        ],
        "properties": {
          "thread_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mechanics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_sheet_ref",
        "provisional_rules_ref",
        "roll_pending",
        "last_roll_provenance"
      ],
      "properties": {
        "current_sheet_ref": {
          "type": "string",
          "minLength": 1
        },
        "provisional_rules_ref": {
          "type": "string",
          "minLength": 1
        },
        "roll_pending": {
          "type": [
            "object",
            "null"
          ]
        },
        "last_roll_provenance": {
          "enum": [
            "NONE",
            "VERIFIED_TOOL",
            "UNVERIFIED_CHAT_PRESENTATION",
            "HISTORICAL_AUDIT_PENDING"
          ]
        }
      }
    },
    "player_agency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_decision",
        "pc_action_not_assumed",
        "xp_purchase_not_assumed",
        "wp_spend_not_assumed"
      ],
      "properties": {
        "next_decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "pc_action_not_assumed": {
          "const": true
        },
        "xp_purchase_not_assumed": {
          "const": true
        },
        "wp_spend_not_assumed": {
          "const": true
        }
      }
    },
    "event_buffer": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "classification",
          "actor",
          "source",
          "state_delta"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "PLAYER_DECLARATION",
              "NPC_ACTION",
              "NARRATOR_ADJUDICATION",
              "MECHANICAL_RESULT",
              "KNOWLEDGE_DELTA",
              "RESOURCE_DELTA",
              "CORRECTION",
              "SCENE_END"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "state_delta": {
            "type": "object"
          },
          "roll_provenance": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "description": "Ephemeral projection only, built from verified GitHub LIVE/INDEX/knowledge. Does not initiate M2.04 or supersede persistent state."
}
