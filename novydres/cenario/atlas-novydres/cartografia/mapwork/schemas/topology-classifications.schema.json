{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Novydres Mapwork classified corridor crossings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reference_sha256",
    "network_sha256",
    "crossings"
  ],
  "properties": {
    "schema": {
      "const": "NOVYDRES_MAPWORK_TOPOLOGY_CLASSIFICATIONS"
    },
    "reference_sha256": {
      "type": "string",
      "minLength": 1
    },
    "network_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protected_edge_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "crossings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/crossing"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "crossing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "corridors",
        "point",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "corridors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "point": {
          "$ref": "#/$defs/point"
        },
        "status": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 8
        },
        "relation": {
          "enum": [
            "at_grade",
            "grade_separated",
            "no_connection"
          ]
        },
        "levels": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 2,
          "maxProperties": 2
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inspected_by",
            "reference_sha256",
            "bbox",
            "observation"
          ],
          "properties": {
            "inspected_by": {
              "const": "AGENT"
            },
            "reference_sha256": {
              "type": "string",
              "minLength": 1
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "observation": {
              "type": "string",
              "minLength": 24
            }
          }
        },
        "geometry_observation": {
          "type": "string",
          "minLength": 16
        },
        "barrier_evidence": {
          "type": "string",
          "minLength": 12
        },
        "editorial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_element"
          ],
          "properties": {
            "new_element": {
              "type": "boolean"
            },
            "status": {
              "enum": [
                "APPROVED",
                "OPEN",
                "REJECTED"
              ]
            },
            "decision_id": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "RESOLVED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "relation",
              "levels",
              "visual",
              "geometry_observation",
              "editorial"
            ]
          }
        }
      ]
    }
  }
}
