{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novydres.local/CHR001_NPC_DISPOSITION_SCHEMA_V1",
  "title": "CHR-001 — Estado social local e transitório",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "chronicle_id",
    "status",
    "checkpoint",
    "previous_version",
    "activation_event_id",
    "actors"
  ],
  "properties": {
    "schema_id": {
      "const": "CHR001_NPC_DISPOSITION_STATE_V1"
    },
    "chronicle_id": {
      "const": "CHR-001"
    },
    "status": {
      "enum": [
        "STAGED",
        "ACTIVE"
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_head_sha",
        "cycle_path",
        "cycle_blob_sha",
        "last_event_id"
      ],
      "properties": {
        "source_head_sha": {
          "$ref": "#/$defs/sha"
        },
        "cycle_path": {
          "type": "string",
          "pattern": "^novydres/chronicles/CHR-001/orchestration/CYCLE_V[0-9]{4}\\.json$"
        },
        "cycle_blob_sha": {
          "$ref": "#/$defs/sha"
        },
        "last_event_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "previous_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "activation_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "actors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^npc-[a-z0-9-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/actor"
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "source_event_id"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "personal_goal",
        "negative_expression",
        "positive_expression",
        "boundaries"
      ],
      "properties": {
        "personal_goal": {
          "type": "string",
          "minLength": 1
        },
        "negative_expression": {
          "type": "string",
          "minLength": 1
        },
        "positive_expression": {
          "type": "string",
          "minLength": 1
        },
        "boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundary"
          }
        }
      }
    },
    "pressure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "delta",
        "reason",
        "source_event_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "delta": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2,
          "not": {
            "const": 0
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "source_event_id",
        "pressures"
      ],
      "properties": {
        "baseline": {
          "type": "integer",
          "minimum": -3,
          "maximum": 3
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1
        },
        "pressures": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/pressure"
          }
        }
      }
    },
    "moodWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_key",
        "period_anchor_event_id",
        "value",
        "method",
        "dice",
        "source_event_id",
        "rng_provenance"
      ],
      "properties": {
        "period_key": {
          "type": "string",
          "minLength": 1
        },
        "period_anchor_event_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        "method": {
          "enum": [
            "TWO_D3_RECORDED",
            "CONTEXT",
            "NEUTRAL_FALLBACK"
          ]
        },
        "dice": {
          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "source_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "rng_provenance": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "relationships",
        "mood_window"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "relationships": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(pc|npc)-[a-z0-9-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/relationship"
          }
        },
        "mood_window": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/moodWindow"
            }
          ]
        }
      }
    }
  }
}
