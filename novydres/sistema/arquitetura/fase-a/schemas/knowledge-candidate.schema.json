{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novydres.invalid/schemas/knowledge-candidate.schema.json",
  "title": "NOVYDRES scoped actor knowledge (candidate only)",
  "type": "object",
  "required": [
    "subject_id",
    "actor_id",
    "scope",
    "confirmed",
    "claims",
    "suspected",
    "unknown",
    "claims_are_not_world_facts"
  ],
  "properties": {
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "confirmed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suspected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims_are_not_world_facts": {
      "type": "boolean"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$comment": "Do not merge NPC claims with CONFIRMED; content semantic truth still requires source review."
}
